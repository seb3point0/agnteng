# @defaultSensitive=inferFromPrefix('PUBLIC_') @defaultRequired=infer
# @generateTypes(lang=ts, path=env.d.ts)
# @currentEnv=$APP_ENV
#
# @plugin(@varlock/1password-plugin@2.0.4)
# @initOp(token=$OP_TOKEN, allowAppAuth=false, cacheTtl=5m)
# ---

# @sensitive=false @type=enum(development, preview, production, test)
APP_ENV=development

# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# Server-only: read in src/lib/luma.ts, never shipped to the client bundle.
# @sensitive @required @type=string(startsWith=secret-)
LUMA_API_KEY=op(op://project-agnteng/LUMA_API_KEY/credential)
