---
// Uniform sticky top bar for the (dark) design-system pages — mirrors the
// Animation Builder's TopBar: brand mark + title, a placeholder menu, and a
// back-to-index link. Drop it in as the first child of each page.
interface Props {
  title?: string;
  back?: boolean;
}
const { title = 'Master Design System', back = true } = Astro.props;
---

<header
  class="sticky top-0 z-[100] flex h-[52px] items-center gap-4 border-b border-white/10 bg-deep-navy/95 px-4 backdrop-blur sm:px-6"
>
  <a href="/" class="flex items-center gap-2.5" aria-label="Agentic Engineering — home">
    <span class="block h-2.5 w-2.5 bg-electric-blue"></span>
    <span class="font-mono text-[13px] font-semibold tracking-tight text-soft-white">{title}</span>
  </a>

  <span class="mx-1 h-5 w-px bg-white/10"></span>
  <button
    type="button"
    aria-label="Menu"
    title="Menu (coming soon)"
    class="flex h-7 w-7 items-center justify-center rounded-md text-soft-white/45 transition-colors hover:bg-white/5 hover:text-soft-white"
  >
    <svg viewBox="0 0 16 16" class="h-4 w-4"
      ><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg
    >
  </button>

  {
    back && (
      <a href="/" class="ml-auto font-mono text-[11px] text-soft-white/45 transition-colors hover:text-periwinkle">
        ← index
      </a>
    )
  }
</header>
