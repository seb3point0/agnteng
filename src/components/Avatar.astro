---
interface Props {
  name?: string;
  src?: string;
  size?: number;
  class?: string;
}
const { name = 'AE', src, size = 40, class: cls } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<span
  class={`inline-flex flex-none items-center justify-center overflow-hidden rounded-full bg-electric-blue font-mono font-semibold text-white ${cls ?? ''}`}
  style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px`}
>
  {src ? <img src={src} alt={name} class="h-full w-full object-cover" /> : initials}
</span>
