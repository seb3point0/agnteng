---
// Pill buttons, aligned to DS1's original styling (border-radius:999px,
// Manrope 600 / 16px, generous padding). Light-context by default.
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  disabled?: boolean;
  target?: string;
  rel?: string;
}
const { variant = 'primary', href, type = 'button', class: cls, disabled, target, rel } = Astro.props;
const computedRel = rel ?? (target === '_blank' ? 'noreferrer' : undefined);

const base =
  'inline-flex items-center justify-center gap-2.5 rounded-full font-sans text-base font-semibold transition-all duration-150 disabled:cursor-not-allowed disabled:opacity-40 focus:outline-none focus-visible:ring-2 focus-visible:ring-bright-blue focus-visible:ring-offset-2';
const variants = {
  primary: 'bg-electric-blue px-[26px] py-3.5 text-white hover:brightness-110 active:translate-y-px',
  secondary: 'bg-deep-navy px-[26px] py-3.5 text-white hover:bg-[#10143a] active:translate-y-px',
  outline:
    'border-[1.5px] border-panel-navy/20 px-6 py-[13px] text-panel-navy hover:border-electric-blue hover:text-electric-blue active:translate-y-px',
  ghost: 'px-2 py-[13px] text-electric-blue hover:brightness-110',
};
const className = `${base} ${variants[variant]} ${cls ?? ''}`;
const Tag = href ? 'a' : 'button';
---

<Tag
  class={className}
  href={href}
  type={href ? undefined : type}
  disabled={disabled}
  target={href ? target : undefined}
  rel={href ? computedRel : undefined}
>
  <slot />
</Tag>
