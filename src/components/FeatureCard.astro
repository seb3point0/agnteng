---
import Icon from './Icon.astro';
interface Props {
  icon: string;
  title: string;
  body: string;
  class?: string;
}
const { icon, title, body, class: cls } = Astro.props;
---

<div class={`rounded-2xl border border-panel-navy/[0.08] bg-white p-6 ${cls ?? ''}`}>
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#EEF1FF] text-electric-blue">
    <Icon name={icon} size={22} />
  </div>
  <h3 class="mt-4 font-mono text-lg font-semibold tracking-tight text-panel-navy">{title}</h3>
  <p class="mt-2 font-sans text-sm leading-relaxed text-panel-navy/55">{body}</p>
</div>
