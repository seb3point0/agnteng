---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Animation from '../../components/Animation.tsx';
import DuotoneField from '../../components/DuotoneField.tsx';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';

// ── Content ─────────────────────────────────────────────────────────────────
const event = {
  title: 'Agentic Engineering Lisbon',
  datetime: 'Wed 29 Jul, 2026 · 19:00',
  venue: 'The Nest, Lisbon',
  registerHref: 'https://luma.com/hqd7vt0v',
};
const calendarHref = 'https://luma.com/interopvc';

// Past events — real photos (Substack) + talk recordings (YouTube playlists).
const pastEvents = [
  {
    name: 'Agentic Engineering Berlin',
    date: 'Tue 16 Jun, 2026',
    photo: '/assets/photos/events/berlin-jun2026.jpg',
    field: {
      animation: 'aurora', color: '#1E2BE6', edge: '#16D9A6', bg: '#05071E',
      cell: 2, gap: 0, density: 0.87, motion: 8, fade: 'none', shape: 'square',
      contrast: 2.05, edgeGlow: 0, tone: 0.8, position: 'center',
    },
    recapHref: 'https://agnteng.substack.com/p/notes-from-agentic-engineering-berlin',
    watchHref: 'https://www.youtube.com/watch?v=FlxGA1n5jyY&list=PLDne67klcsVc',
    flip: true,
  },
  {
    name: 'Agentic Engineering Lisbon',
    date: 'Wed 27 May, 2026',
    photo: '/assets/photos/events/lisbon-may2026.jpg',
    field: {
      animation: 'aurora', color: '#1E2BE6', edge: '#1FC6E6', bg: '#05071E',
      cell: 2, gap: 0, density: 0.87, motion: 8, fade: 'none', shape: 'square',
      contrast: 2.05, edgeGlow: 0, tone: 0.8, position: 'center',
    },
    recapHref: 'https://agnteng.substack.com/p/notes-from-the-first-agentic-engineering',
    watchHref: 'https://www.youtube.com/watch?v=KRzbyKm1thI&list=PLhMvm2rCioKoxhEBxXAPPpLm5SASyWJW2',
  },
];

const partnerEmail = 'mailto:partners@agnteng.com';

// Hero + partner-band field animation (partner band mirrors the hero).
const HERO_ANIM = {
  animation: 'aurora',
  color: '#1E2BE6',
  edge: '#ED4BA0',
  bg: '#05071E',
  cell: 2,
  gap: 0,
  density: 0.65,
  motion: 8,
  fade: 'none',
  shape: 'square',
} as const;
---

<Base title="Agentic Engineering — a community for people building with agents">
  <!-- ░░ NAV ░░ -->
  <Navbar
    links={['Events', 'Partner']}
    linkHrefs={['#events', '#partner']}
    cta="Register"
    ctaHref={event.registerHref}
    signIn={false}
    class="sticky top-0 z-50"
  />

  <!-- ░░ HERO — compact; tagline → Lisbon line → thesis → CTAs ░░ -->
  <section class="relative overflow-hidden bg-deep-navy px-6 py-20 sm:px-12 sm:py-24">
    <Animation client:visible {...HERO_ANIM} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(90deg,#05071E 0%,rgba(5,7,30,0.82) 44%,rgba(5,7,30,0.4) 80%,rgba(5,7,30,0.6) 100%)"></div>
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,7,30,0.5) 0%,transparent 30%,transparent 60%,#05071E 100%)"></div>

    <div class="relative z-10 mx-auto w-full max-w-[1280px]">
      <h1 class="max-w-[1120px] font-mono text-[26px] font-semibold leading-[1.12] tracking-tight text-soft-white sm:text-[34px] md:text-[40px]">
        A community of engineers and founders <br class="hidden sm:inline" />turning agents into an unfair advantage.
      </h1>

      <p class="mt-5 font-sans text-lg font-semibold text-periwinkle sm:text-xl">
        Monthly in-person meetup in Lisbon
      </p>
    </div>
  </section>

  <!-- ░░ NEXT EVENT — the upcoming one, featured ░░ -->
  <section id="next" class="bg-soft-white px-6 py-20 sm:px-12 sm:py-24">
    <div class="mx-auto max-w-[1280px]">
      <h2 class="font-sans text-2xl font-bold tracking-tight text-panel-navy sm:text-3xl">Next in-person event</h2>

      <article class="mt-8 grid overflow-hidden rounded-2xl border border-panel-navy/[0.08] bg-white lg:grid-cols-2">
        <!-- duotone venue image -->
        <div class="relative min-h-[300px] bg-deep-navy">
          <DuotoneField
            client:visible
            src="/assets/photos/event-lisbon.jpg"
            animation="aurora"
            color="#1E2BE6"
            edge="#B5A6FF"
            bg="#05071E"
            cell={2}
            gap={0}
            density={0.65}
            motion={8}
            fade="none"
            shape="square"
            contrast={2.05}
            edgeGlow={0}
            tone={0.8}
            position="left"
            style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }}
          />
          <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,7,30,0.18) 0%,rgba(5,7,30,0) 30%,rgba(5,7,30,0.12) 100%)"></div>
        </div>

        <!-- content -->
        <div class="flex flex-col justify-center gap-5 p-8 sm:p-10">
          <div>
            <h3 class="font-sans text-xl font-bold tracking-tight text-panel-navy sm:text-2xl">{event.title}</h3>
            <div class="mt-3 flex flex-col gap-2 font-mono text-sm text-panel-navy/70">
              <span class="flex items-center gap-2.5"><Icon name="Calendar" size={15} class="text-electric-blue" /> {event.datetime}</span>
              <span class="flex items-center gap-2.5"><Icon name="MapPin" size={15} class="text-electric-blue" /> {event.venue}</span>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary" href={event.registerHref} target="_blank">Register</Button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ░░ PAST EVENTS — featured with real photos + talk recordings ░░ -->
  <section id="events" class="bg-soft-white px-6 pb-28 sm:px-12">
    <div class="mx-auto max-w-[1280px]">
      <h2 class="font-sans text-2xl font-bold tracking-tight text-panel-navy sm:text-3xl">Past events</h2>

      <div class="mt-10 flex flex-col gap-8">
        {pastEvents.map((e, idx) => (
          <article class="grid overflow-hidden rounded-2xl border border-panel-navy/[0.08] bg-white lg:grid-cols-2">
            <!-- real event photo, treated as a brand duotone (per-event field) -->
            <div class={`relative min-h-[300px] bg-deep-navy ${idx % 2 ? 'lg:order-2' : ''}`}>
              <DuotoneField client:visible src={e.photo} {...e.field} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', transform: e.flip ? 'scaleX(-1)' : undefined }} />
              <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,7,30,0.18) 0%,rgba(5,7,30,0) 30%,rgba(5,7,30,0.12) 100%)"></div>
            </div>

            <!-- content -->
            <div class="flex flex-col justify-center gap-5 p-8 sm:p-10">
              <div>
                <h3 class="font-sans text-xl font-bold tracking-tight text-panel-navy sm:text-2xl">{e.name}</h3>
                <p class="mt-1.5 font-mono text-[12px] uppercase tracking-[0.16em] text-electric-blue">{e.date}</p>
              </div>

              <div class="mt-3 flex flex-wrap items-center gap-3">
                <Button variant="outline" href={e.recapHref} target="_blank">Read the recap</Button>
                <Button variant="ghost" href={e.watchHref} target="_blank">Watch the talks <Icon name="ArrowRight" size={14} /></Button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ PARTNER WITH US — light CTA band ░░ -->
  <section id="partner" class="bg-soft-white px-6 pb-28 sm:px-12">
    <div class="mx-auto max-w-[1280px]">
      <div class="relative overflow-hidden rounded-3xl bg-deep-navy px-8 py-12 sm:px-12">
        <Animation client:visible {...HERO_ANIM} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', opacity: 0.55 }} />
        <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(90deg,#05071E 24%,rgba(5,7,30,0.2) 100%)"></div>

        <div class="relative z-10 flex flex-wrap items-center justify-between gap-8">
          <div class="max-w-xl">
            <h2 class="font-mono text-2xl font-semibold tracking-tight text-soft-white sm:text-3xl">Partner with us</h2>
            <p class="mt-3 font-sans text-[15px] leading-relaxed text-soft-white/70">
              Back the room where agents get built. We keep sponsorships small and well-matched — a few
              partners who actually want to be there. Open for 2026.
            </p>
          </div>
          <Button variant="primary" href={partnerEmail}>Get in touch</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ FOOTER ░░ -->
  <Footer socials={['luma', 'substack', 'x', 'youtube', 'linkedin']} />
</Base>
