---
import Base from '../../layouts/Base.astro';
import SlideDeck from '../../components/slides-2026-08-26/SlideDeck.tsx';
import { getAllGuests, getSupporterNames, getEventAudience } from '../../lib/luma';
import { LUMA_EVENT_API_ID, LUMA_EVENT_START_AT } from '../../components/slides-2026-08-26/content';

// Thin shell, same reasoning as lisbon-2026-07-29.astro — the deck lives in
// .tsx because a React island can't receive component children with props
// across an Astro slot boundary. The Luma fetch happens here (server-side,
// build time) rather than in a .tsx file, so LUMA_API_KEY never reaches the
// client bundle; guests are fetched once and both Luma-backed slides derive
// their data from that one list, as plain serialisable props.
const guests = await getAllGuests(LUMA_EVENT_API_ID);
const supporters = getSupporterNames(guests);
const audience = getEventAudience(guests, LUMA_EVENT_START_AT);
---

<Base
  title="Meetup Slides — Lisbon, 26 Aug 2026"
  description="Agentic Engineering Lisbon meetup deck, 26 Aug 2026."
  bodyClass="h-screen overflow-hidden bg-black font-sans text-soft-white antialiased"
>
  <SlideDeck client:load supporters={supporters} audience={audience} />
</Base>
