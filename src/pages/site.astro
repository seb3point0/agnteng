---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Animation from '../components/Animation.tsx';
import DuotoneField from '../components/DuotoneField.tsx';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

// ── Content (placeholder — swap for real values before launch) ──────────────
// TODO(launch): real next-event details + Luma URL, per-event recap/watch links,
// the partner email.
const event = {
  title: 'Agentic Engineering Lisbon',
  datetime: 'Wed 29 Jul, 2026 · 19:00',
  venue: 'The Nest, Lisbon',
  registerHref: 'https://luma.com/hqd7vt0v',
};

// Full events calendar (subscribe / browse all) — distinct from a single event's
// registration link above.
const calendarHref = 'https://luma.com/interopvc';

// Past events — one entry per meetup. Only the links an event actually has are
// shown (recap = Substack write-up, watch = YouTube recording). Add a row to grow.
const pastEvents = [
  {
    name: 'Agentic Engineering Berlin',
    date: 'Tue 16 Jun, 2026',
    recapHref: 'https://agnteng.substack.com/p/notes-from-agentic-engineering-berlin',
    watchHref: 'https://www.youtube.com/watch?v=FlxGA1n5jyY&list=PLDne67klcsVc',
  },
  {
    name: 'Agentic Engineering Lisbon',
    date: 'Wed 27 May, 2026',
    recapHref: 'https://agnteng.substack.com/p/notes-from-the-first-agentic-engineering',
    watchHref: 'https://www.youtube.com/watch?v=KRzbyKm1thI&list=PLhMvm2rCioKoxhEBxXAPPpLm5SASyWJW2',
  },
] as const;

const substackUrl = 'https://agnteng.substack.com';
const partnerEmail = 'mailto:partners@agnteng.com';

// Shared field animation — the hero config, reused wherever a pure animated
// field appears (partner band, past-event thumbnails) so they stay in sync.
// The event-card duotone matches this field's character (aurora, colours, motion)
// but keeps its own coverage/image params so the photo still renders.
const HERO_ANIM = {
  animation: 'aurora',
  color: '#1E2BE6',
  edge: '#ED4BA0',
  bg: '#05071E',
  cell: 3,
  gap: 0,
  density: 0.66,
  motion: 30,
  fade: 'none',
  shape: 'square',
} as const;
---

<Base title="Agentic Engineering — agents, in production, in Lisbon">
  <!-- ░░ NAV ░░ -->
  <Navbar
    links={['Recaps', 'Partner']}
    linkHrefs={['#recaps', '#partner']}
    cta="Join our events"
    ctaHref={calendarHref}
    signIn={false}
    class="sticky top-0 z-50"
  />

  <!-- ░░ HERO — layered field + iridescent brand glow ░░ -->
  <section class="relative flex min-h-screen items-center overflow-hidden bg-deep-navy px-6 sm:px-12">
    <!-- animated field (shared HERO_ANIM config) -->
    <Animation client:visible {...HERO_ANIM} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
    <!-- legibility scrims -->
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(90deg,#05071E 0%,rgba(5,7,30,0.82) 38%,rgba(5,7,30,0.3) 72%,rgba(5,7,30,0.5) 100%)"></div>
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,7,30,0.6) 0%,transparent 22%,transparent 58%,#05071E 100%)"></div>

    <div class="relative z-10 mx-auto w-full max-w-[1280px] py-28">
      <h1 class="max-w-4xl font-mono text-[34px] font-semibold leading-[1.05] tracking-tight text-soft-white sm:text-5xl md:text-[62px]">
        Agentic workflows are moving to the center of how we build.
      </h1>

      <p class="mt-7 max-w-xl font-sans text-lg leading-relaxed text-soft-white/75">
        A community for the engineers, founders and operators wiring agents into real products and companies.
      </p>

      <div class="mt-10">
        <Button variant="primary" href={calendarHref}>Join our events</Button>
      </div>
    </div>
  </section>

  <!-- ░░ NEXT IN-PERSON EVENT — animated duotone of the venue/city ░░ -->
  <section id="next" class="bg-soft-white px-6 py-24 sm:px-12">
    <div class="mx-auto max-w-[1280px]">
      <h2 class="font-sans text-2xl font-bold tracking-tight text-panel-navy sm:text-3xl">Next in-person event</h2>

      <div class="relative mt-8 flex min-h-[460px] items-end overflow-hidden rounded-2xl bg-deep-navy">
        <DuotoneField
          client:visible
          src="/assets/photos/event-lisbon.jpg"
          animation="aurora"
          color="#1E2BE6"
          edge="#ED4BA0"
          bg="#05071E"
          cell={2}
          gap={0}
          density={1}
          motion={30}
          fade="none"
          shape="square"
          contrast={1.85}
          edgeGlow={0.65}
          tone={0.8}
          position="left"
          style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }}
        />
        <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(90deg,#05071E 0%,rgba(5,7,30,0.7) 46%,rgba(5,7,30,0.2) 100%)"></div>
        <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,transparent 35%,rgba(5,7,30,0.8) 100%)"></div>

        <div class="relative z-10 max-w-2xl p-8 sm:p-12">
          <h3 class="font-sans text-2xl font-bold leading-tight tracking-tight text-soft-white sm:text-[34px]">
            {event.title}
          </h3>
          <div class="mt-6 flex flex-col gap-2.5 font-mono text-sm text-soft-white/85">
            <span class="flex items-center gap-2.5"><Icon name="Calendar" size={16} class="text-periwinkle" /> {event.datetime}</span>
            <span class="flex items-center gap-2.5"><Icon name="MapPin" size={16} class="text-periwinkle" /> {event.venue}</span>
          </div>
          <div class="mt-8">
            <Button variant="primary" href={event.registerHref}>Register</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ PAST EVENTS — archive rows ░░ -->
  <section id="recaps" class="bg-soft-white px-6 pb-28 sm:px-12">
    <div class="mx-auto max-w-[1280px]">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-sans text-2xl font-bold tracking-tight text-panel-navy sm:text-3xl">Past events</h2>
        <a href={substackUrl} target="_blank" rel="noreferrer" class="font-mono text-sm text-electric-blue transition hover:brightness-110">All recaps on Substack →</a>
      </div>

      <div class="mt-8 divide-y divide-panel-navy/10 border-y border-panel-navy/10">
        {pastEvents.map((e) => (
          <div class="flex items-center gap-5 py-6">
            <div class="relative hidden h-14 w-20 shrink-0 overflow-hidden rounded-lg bg-deep-navy sm:block">
              <Animation client:visible {...HERO_ANIM} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
            </div>
            <div class="min-w-0">
              <div class="font-sans text-lg font-bold tracking-tight text-panel-navy">{e.name}</div>
              <div class="mt-0.5 font-mono text-[13px] text-panel-navy/55">{e.date}</div>
            </div>
            <div class="ml-auto flex shrink-0 items-center gap-5">
              {e.recapHref && (
                <a href={e.recapHref} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 font-mono text-sm font-semibold text-electric-blue transition hover:brightness-110">
                  Recap <Icon name="ExternalLink" size={13} />
                </a>
              )}
              {e.watchHref && (
                <a href={e.watchHref} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 font-mono text-sm font-semibold text-electric-blue transition hover:brightness-110">
                  Watch <Icon name="ExternalLink" size={13} />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ PARTNER WITH US — light CTA band ░░ -->
  <section id="partner" class="bg-soft-white px-6 pb-28 sm:px-12">
    <div class="mx-auto max-w-[1280px]">
      <div class="relative overflow-hidden rounded-3xl bg-deep-navy px-8 py-12 sm:px-12">
        <Animation client:visible {...HERO_ANIM} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', opacity: 0.55 }} />
        <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(90deg,#05071E 24%,rgba(5,7,30,0.2) 100%)"></div>

        <div class="relative z-10 flex flex-wrap items-center justify-between gap-8">
          <div class="max-w-xl">
            <h2 class="font-mono text-2xl font-semibold tracking-tight text-soft-white sm:text-3xl">Partner with us</h2>
            <p class="mt-3 font-sans text-[15px] leading-relaxed text-soft-white/70">
              Back the room where agents get built. We keep sponsorships small and well-matched — a few
              partners who actually want to be there. Open for 2026.
            </p>
          </div>
          <Button variant="primary" href={partnerEmail}>Get in touch</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ FOOTER ░░ -->
  <Footer socials={['luma', 'substack', 'x', 'youtube', 'linkedin']} />
</Base>
